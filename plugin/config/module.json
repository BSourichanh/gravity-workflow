{
  "schema_version": 1,
  "id": "workflow",
  "plugin_name": "gravity-workflow",
  "role": "Harnais multi-agents, workflows orchestrateurs, garde-fous fail-closed, evals et /caveman",
  "storage": {
    "subdir": "workflow",
    "env_override": "GRAVITY_WORKFLOW_HOME"
  },
  "commands": [
    "/gravity-workflow",
    "/caveman"
  ],
  "capabilities": [
    "orchestrator-workflows",
    "safety-hooks",
    "evals",
    "adaptive-routing"
  ],
  "ui": {
    "mode": "none",
    "target": "gravity"
  },
  "dashboard": {
    "provider_script": "scripts/dashboard_provider.py",
    "views": [
      "workflow",
      "health"
    ],
    "actions": []
  },
  "signals": {
    "produces": [
      "workflow-state",
      "routing-profile"
    ],
    "consumes": [
      "session-metrics"
    ]
  },
  "capture_policy": {
    "commands": [
      "/gravity-workflow"
    ],
    "exclude_subcommands": [
      "status",
      "evals",
      "init",
      "help"
    ],
    "consultative_bypass": true,
    "label_prefix": "workflow"
  }
}
