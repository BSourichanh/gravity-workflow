{
  "harness-pre-tool-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|execute_command|bash|shell|run_workflow|write_to_file|write_file|replace_file_content|edit_file|multi_replace_file_content|view_file|read_file|grep_search|search_files|list_dir|find_by_name|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "harness-post-edit-format": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|write_file|replace_file_content|edit_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/post_tool_format.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "harness-session-caveman": {
    "enabled": false,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 hooks/session_start_caveman.py",
        "timeout": 10
      }
    ]
  },
  "harness-session-metrics": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 hooks/stop_session_logger.py",
        "timeout": 10
      }
    ]
  }
}
